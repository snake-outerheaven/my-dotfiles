# ~/.config/i3/config - i3 sem barra, paleta Tango, destaque amarelo
# Modular: cada assunto num arquivo de config.d/, carregados em ordem.
# Ajustes so desta maquina: ~/.config/i3/local.conf (fora do git; o install.sh cria vazio).
# Variaveis usadas pelos modulos ficam aqui: o i3 nao deixa um arquivo
# usar variavel definida em outro arquivo incluido.
# Recarregar: Super+Shift+c   Reiniciar: Super+Shift+r   Sair: Super+Shift+e

set $mod Mod4
set $up l
set $down k
set $left j
set $right semicolon

font pango:Cascadia Code 9

include ~/.config/i3/config.d/*.conf
include ~/.config/i3/local.conf
