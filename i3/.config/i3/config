# ~/.config/i3/config - i3 no OpenBSD, paleta Tango, destaque amarelo, barra embaixo
# Binds: os padroes do i3, com Super (Mod4). Extras marcados com "extra".
# Recarregar: Super+Shift+c   Reiniciar: Super+Shift+r   Sair: Super+Shift+e
# Relogio, bateria e volume: Super+i (notificacao por 5 s)

set $mod Mod4
font pango:Cascadia Code 9

# --- Tango ---
set $butter1   #fce94f
set $butter2   #edd400
set $alu1      #eeeeec
set $alu3      #babdb6
set $alu4      #888a85
set $alu5      #555753
set $alu6      #2e3436
set $scarlet   #cc0000

# classe                borda     fundo     texto     indicador indicador-filho
client.focused          $butter2  $butter2  $alu6     $butter1  $butter2
client.focused_inactive $alu5     $alu5     $alu1     $alu5     $alu5
client.unfocused        $alu6     $alu6     $alu4     $alu6     $alu6
client.urgent           $scarlet  $scarlet  $alu1     $scarlet  $scarlet
client.placeholder      $alu6     $alu6     $alu1     $alu6     $alu6
client.background       $alu6

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none
gaps inner 6
gaps outer 0

# --- sessao (o i3 faz o papel do antigo cwm-session) ---
exec --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id ~/.local/bin/fundo
exec --no-startup-id dunst
exec_always --no-startup-id volume mostra
# CopyQ sempre em segundo plano: --start-server sobe o servidor sem janela se ele
# nao estiver rodando; hide_main_window evita a janela quando nao ha bandeja.
# exec_always: vale tambem depois de Super+Shift+r.
exec_always --no-startup-id copyq --start-server config hide_main_window true
exec_always --no-startup-id sh -c 'sleep 3; copyq loadTheme ~/.local/share/copyq-temas/tango.ini'
exec --no-startup-id xidle -timeout 300 -program "/usr/X11R6/bin/xlock -mode qix"

# --- volume, brilho, print, bloqueio (extra: OpenBSD) ---
# --release: scrot -s e xlock precisam pegar o teclado, entao rodam ao soltar a tecla
bindsym XF86AudioRaiseVolume exec --no-startup-id volume +
bindsym XF86AudioLowerVolume exec --no-startup-id volume -
bindsym XF86AudioMute        exec --no-startup-id volume mudo
bindsym XF86MonBrightnessUp   exec --no-startup-id xbacklight -inc 10
bindsym XF86MonBrightnessDown exec --no-startup-id xbacklight -dec 10
bindsym Print      exec --no-startup-id printar
bindsym --release $mod+Print exec --no-startup-id printar -s
bindsym --release $mod+Shift+x exec --no-startup-id xlock -mode qix

# --- padroes do i3 ---
set $up l
set $down k
set $left j
set $right semicolon

floating_modifier $mod
tiling_drag modifier titlebar

bindsym $mod+Return exec alacritty
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id rofi -show drun

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

set $ws1 "1:I"
set $ws2 "2:II"
set $ws3 "3:III"
set $ws4 "4:IV"
set $ws5 "5:V"
set $ws6 "6:VI"
set $ws7 "7:VII"
set $ws8 "8:VIII"
set $ws9 "9:IX"
set $ws10 "10:X"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Sair do i3?' -B 'Sim, sair' 'i3-msg exit'"

mode "resize" {
	bindsym $left  resize shrink width 10 px or 10 ppt
	bindsym $down  resize grow height 10 px or 10 ppt
	bindsym $up    resize shrink height 10 px or 10 ppt
	bindsym $right resize grow width 10 px or 10 ppt
	bindsym Left   resize shrink width 10 px or 10 ppt
	bindsym Down   resize grow height 10 px or 10 ppt
	bindsym Up     resize shrink height 10 px or 10 ppt
	bindsym Right  resize grow width 10 px or 10 ppt
	bindsym Return mode "default"
	bindsym Escape mode "default"
	bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# --- barra (i3bar + i3status), Tango ---
# Areas com nome "N:ROMANO": o i3bar mostra so o romano (strip_workspace_numbers).
bar {
	position bottom
	status_command i3status
	strip_workspace_numbers yes
	font pango:Cascadia Code 9
	colors {
		background #2e3436
		statusline #eeeeec
		separator  #555753
		#                  borda    fundo    texto
		focused_workspace  #edd400  #edd400  #2e3436
		active_workspace   #555753  #555753  #eeeeec
		inactive_workspace #2e3436  #2e3436  #888a85
		urgent_workspace   #cc0000  #cc0000  #eeeeec
		binding_mode       #c4a000  #c4a000  #2e3436
	}
}
