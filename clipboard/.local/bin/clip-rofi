#!/bin/sh
# clip-rofi - escolhe um item do historico (clipd) no rofi e copia de volta
#
# Uso:  clip-rofi       abre o menu (no i3: Super+v)
#       clip-rofi -l    limpa todo o historico

DIR="${XDG_CACHE_HOME:-$HOME/.cache}/clipboard"

if [ "${1:-}" = "-l" ]; then
	rm -f "$DIR"/* "$DIR/.ultimo" "$DIR/.novo"
	exit 0
fi

[ -d "$DIR" ] || exit 0
# nomes sao data-numero, ls e seguro
# shellcheck disable=SC2012
lista=$(ls -1t "$DIR")
[ -n "$lista" ] || exit 0

# uma linha por item: so a primeira linha, cortada em 80 caracteres
escolha=$(printf '%s\n' "$lista" | while read -r f; do
	linha=$(head -n 1 "$DIR/$f" | tr '\t' ' ' | cut -c 1-80)
	[ "$(wc -l < "$DIR/$f")" -gt 1 ] && linha="$linha  …"
	printf '%s\n' "$linha"
done | rofi -dmenu -i -p "clip" -format i)

[ -n "$escolha" ] || exit 0
f=$(printf '%s\n' "$lista" | sed -n "$((escolha + 1))p")
[ -n "$f" ] && xclip -selection clipboard -i < "$DIR/$f"
