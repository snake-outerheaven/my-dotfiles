#!/bin/sh
# clipd - guarda o historico da area de transferencia (precisa do xclip)
#
# Roda em segundo plano (o i3 ja inicia). A cada segundo le o clipboard;
# se mudou, salva uma copia em ~/.cache/clipboard. Guarda as ultimas MAX.
# Atencao: senhas copiadas tambem entram no historico. Limpe com: clip-rofi -l

DIR="${XDG_CACHE_HOME:-$HOME/.cache}/clipboard"
MAX=50
LIMITE=1048576   # ignora textos maiores que 1 MiB

mkdir -p "$DIR" && chmod 700 "$DIR"
n=0

while :; do
	if xclip -o -selection clipboard > "$DIR/.novo" 2>/dev/null &&
	   [ -s "$DIR/.novo" ] &&
	   [ "$(wc -c < "$DIR/.novo")" -le "$LIMITE" ] &&
	   ! cmp -s "$DIR/.novo" "$DIR/.ultimo"; then
		cp "$DIR/.novo" "$DIR/.ultimo"
		# se o texto ja estava no historico, tira a copia velha (ele volta para o topo)
		for velho in "$DIR"/[0-9]*; do
			[ -f "$velho" ] && cmp -s "$DIR/.novo" "$velho" && rm -f "$velho"
		done
		n=$((n + 1))
		mv "$DIR/.novo" "$DIR/$(date +%Y%m%d%H%M%S)-$n"
		# apaga as copias mais antigas alem de MAX (nomes sao data-numero, ls e seguro)
		# shellcheck disable=SC2012
		ls -1t "$DIR" | sed -n "$((MAX + 1)),\$p" | while read -r velho; do
			rm -f "$DIR/$velho"
		done
	fi
	sleep 1
done
