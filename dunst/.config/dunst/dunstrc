[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 300
    origin = top-right
    offset = 10x50
    scale = 0
    notification_limit = 0

    ### Estética Everforest ###
    font = Cascadia Mono 10
    frame_width = 2
    frame_color = "#ffcc00"
    separator_color = frame
    corner_radius = 4

[urgency_low]
    background = "#0a0a0a"
    foreground = "#e6e6e6"
    timeout = 10

[urgency_normal]
    background = "#0a0a0a"
    foreground = "#e6e6e6"
    timeout = 10

[urgency_critical]
    background = "#0a0a0a"
    foreground = "#e6e6e6"
    frame_color = "#ff5555"
    timeout = 0# vim: ft=cfg
