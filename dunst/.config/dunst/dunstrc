# dunstrc - base; cores em dunstrc.d/10-cores.conf (drop-in, dunst(1))
# Ajustes desta maquina: dunstrc.d/99-local.conf (fora do git; pode nao existir).
[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 300
    origin = top-right
    offset = 10x10
    scale = 0
    notification_limit = 0
    font = Cascadia Mono 10
    frame_width = 2
    separator_color = frame
    corner_radius = 4

[urgency_low]
    timeout = 10

[urgency_normal]
    timeout = 10

[urgency_critical]
    timeout = 0

# vim: ft=cfg
