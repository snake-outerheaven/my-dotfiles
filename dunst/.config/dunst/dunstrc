[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 300
    origin = top-right
    offset = 10x10
    scale = 0
    notification_limit = 0

    ### Estética Tango, destaque amarelo ###
    font = NotoSansM Nerd Font Mono 10
    frame_width = 2
    frame_color = "#edd400"
    separator_color = frame
    corner_radius = 4

[urgency_low]
    background = "#2e3436"
    foreground = "#eeeeec"
    timeout = 10

[urgency_normal]
    background = "#2e3436"
    foreground = "#eeeeec"
    timeout = 10

[urgency_critical]
    background = "#2e3436"
    foreground = "#eeeeec"
    frame_color = "#ef2929"
    timeout = 0# vim: ft=cfg
