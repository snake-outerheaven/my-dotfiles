# ~/.cwmrc - cwm (base do OpenBSD) em Gruvbox dark medium, destaque amarelo
# Iniciar: startx (o ~/.xinitrc chama ~/.local/bin/cwm-session)
# Recarregar depois de editar: Super+Shift+r

fontname "Cascadia Code:pixelsize=14"
borderwidth 2
gap 6 6 6 6
snapdist 8
sticky yes

# cores
color activeborder   "#fabd2f"
color inactiveborder "#3c3836"
color urgencyborder  "#fb4934"
color groupborder    "#83a598"
color ungroupborder  "#504945"
color menubg         "#282828"
color menufg         "#fabd2f"
color font           "#ebdbb2"
color selfont        "#282828"

# programas do menu (Super+botao direito no fundo, ou Super+/)
command term     alacritty
command firefox  firefox
command copyq    "copyq toggle"
command lazer    lazer

# janelas que nao entram em grupo (ficam em todos)
autogroup 0 "copyq"

# --- atalhos (4 = Super, S = Shift, C = Ctrl) ---
bind-key 4-Return    terminal
bind-key 4-d         "rofi -show drun"
bind-key 4-slash     menu-exec
bind-key 4S-q        window-close
bind-key 4-f         window-fullscreen
bind-key 4-m         window-maximize
bind-key 4-h         window-snap-left
bind-key 4-l         window-snap-right
bind-key 4-k         window-snap-up
bind-key 4-j         window-snap-down
bind-key 4-Tab       window-cycle
bind-key 4S-Tab      window-rcycle
bind-key 4-v         "copyq toggle"
bind-key 4-g         lazer
bind-key 4S-x        "i3lock -c 282828"
bind-key 4S-r        restart
bind-key 4S-e        quit

# areas (grupos) I a IX
bind-key 4-1 group-only-1
bind-key 4-2 group-only-2
bind-key 4-3 group-only-3
bind-key 4-4 group-only-4
bind-key 4-5 group-only-5
bind-key 4-6 group-only-6
bind-key 4-7 group-only-7
bind-key 4-8 group-only-8
bind-key 4-9 group-only-9
bind-key 4S-1 window-movetogroup-1
bind-key 4S-2 window-movetogroup-2
bind-key 4S-3 window-movetogroup-3
bind-key 4S-4 window-movetogroup-4
bind-key 4S-5 window-movetogroup-5
bind-key 4S-6 window-movetogroup-6
bind-key 4S-7 window-movetogroup-7
bind-key 4S-8 window-movetogroup-8
bind-key 4S-9 window-movetogroup-9

# volume, brilho e print (teclas do ThinkPad)
bind-key XF86AudioRaiseVolume "sndioctl -q output.level=+0.1"
bind-key XF86AudioLowerVolume "sndioctl -q output.level=-0.1"
bind-key XF86AudioMute        "sndioctl -q output.mute=!"
bind-key XF86MonBrightnessUp   "xbacklight -inc 10"
bind-key XF86MonBrightnessDown "xbacklight -dec 10"
bind-key Print                "scrot -e 'mv $f ~/Downloads'"

# mouse: Super + botao esquerdo move, Super + direito redimensiona
bind-mouse 4-1 window-move
bind-mouse 4-3 window-resize
