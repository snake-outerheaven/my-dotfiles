#!/bin/sh
# printar - print da tela em Imagens/Capturas (Print = tela toda, Super+Print = area)
# A pasta Imagens vem do xdg-user-dirs (~/.config/user-dirs.dirs).
IMAGENS=$(xdg-user-dir PICTURES 2>/dev/null) || IMAGENS="$HOME/Imagens"
DESTINO="$IMAGENS/Capturas"
mkdir -p "$DESTINO"
if [ "${1:-}" = "-s" ]; then
	scrot -s "$DESTINO/%Y%m%d-%H%M%S.png"
else
	scrot "$DESTINO/%Y%m%d-%H%M%S.png"
fi
