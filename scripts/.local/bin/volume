#!/bin/sh
# volume - sobe, desce ou muta o volume (sndioctl) e atualiza a barra
# Uso: volume +|-|mudo|mostra
# O i3status nao le o sndiod no OpenBSD; este script grava o valor em
# ~/.cache/volume e manda SIGUSR1 para o i3status atualizar na hora.
case "${1:-mostra}" in
+)    sndioctl -q output.level=+0.1 ;;
-)    sndioctl -q output.level=-0.1 ;;
mudo) sndioctl -q output.mute=! ;;
esac

mkdir -p "$HOME/.cache"
if [ "$(sndioctl -n output.mute 2>/dev/null)" = 1 ]; then
	echo mudo
else
	sndioctl -n output.level 2>/dev/null | awk '{printf "%d%%\n", $1 * 100 + 0.5}'
fi > "$HOME/.cache/volume"

pkill -USR1 -x i3status 2>/dev/null
exit 0
