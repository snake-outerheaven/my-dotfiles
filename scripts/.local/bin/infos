#!/bin/sh
# infos - relogio, bateria e volume numa notificacao (Super+i no i3, ja que nao ha barra)
# Uso: infos       mostra no dunst por 5 s
#      infos -1    imprime no terminal
# Num computador sem bateria, a bateria nao aparece.

bateria() {
	case "$(uname -s)" in
	OpenBSD)
		# apm -b: 4 = sem bateria, 255 = desconhecido (apm(8))
		case "$(apm -b 2>/dev/null)" in 4|255|"") return ;; esac
		carga=$(apm -l 2>/dev/null)
		[ "$carga" -ge 0 ] 2>/dev/null || { echo "BAT ?   "; return; }
		if [ "$(apm -a 2>/dev/null)" = 1 ]; then echo "BAT $carga% (na tomada)   "
		else echo "BAT $carga%   "; fi ;;
	NetBSD)
		# envstat(8): sensor "charge" do acpibat0; sem acpibat0 = sem bateria
		carga=$(envstat -d acpibat0 2>/dev/null | awk '/charge:/ {
			for (i = 1; i <= NF; i++) if ($i ~ /%\)?$/) { gsub(/[()%]/, "", $i); printf "%d", $i + 0.5 } }')
		[ -n "$carga" ] && echo "BAT $carga%   " ;;
	esac
}

TITULO=$(date '+%H:%M  %d/%m/%Y')
CORPO="$(bateria)VOL $(volume mostra)"

if [ "${1:-}" = "-1" ]; then
	printf '%s\n%s\n' "$TITULO" "$CORPO"
else
	dunstify -r 4242 -t 5000 "$TITULO" "$CORPO"
fi
