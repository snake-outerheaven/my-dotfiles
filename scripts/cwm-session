#!/bin/sh
# cwm-session - sessao do cwm (o cwm nao tem autostart proprio)
# Instalado em /usr/local/libexec/openbsd-cwm/ pelo install.sh.
# Chamado pelo ~/.xinitrc (startx) e pelo ~/.xsession (xenodm).
# Nao mexe no PATH: tudo do projeto e chamado pelo caminho completo.

LIBEXEC=/usr/local/libexec/openbsd-cwm
SHARE=/usr/local/share/openbsd-cwm

# barramento D-Bus da sessao: o dunst e o copyq precisam dele
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null; then
	eval "$(dbus-launch --sh-syntax --exit-with-session)"
fi

# cores do X: o seu ~/.Xresources (vem do projeto pelo stow, e e seu para editar)
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# fundo: o seu ~/.fehbg, ou a cor lisa Tango
"$LIBEXEC/fundo"

# notificacoes logo depois do D-Bus, para nenhum aviso abrir um dunst sem o tema
command -v dunst >/dev/null && dunst -config "$SHARE/dunstrc" &

# area de transferencia, com o tema Tango aplicado quando o servidor ja respondeu
if command -v copyq >/dev/null; then
	copyq --start-server >/dev/null 2>&1 &
	( sleep 3; copyq loadTheme "$SHARE/copyq-tango.ini" >/dev/null 2>&1 ) &
fi

# bloqueio apos 5 min parado; -no desliga o bloqueio pelo canto da tela.
# O /etc/apm/suspend (opcional) manda SIGUSR1 ao xidle para bloquear antes de dormir.
[ -x /usr/local/bin/i3lock ] && \
	xidle -no -timeout 300 -program "/usr/local/bin/i3lock -c 2e3436" &

exec cwm
