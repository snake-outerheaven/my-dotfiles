#!/bin/sh
# perfil-maquina - diz se a maquina e "notebook" (tem bateria) ou "desktop"
#
# Ordem de decisao:
#   1. variavel PERFIL=desktop|notebook        (forcar na hora)
#   2. arquivo /etc/openbsd-cwm/perfil            (gravado pelo install.sh)
#   3. deteccao: sensor acpibat* ou apm com bateria presente e carga de 1 a 100
#
# Uso: perfil-maquina          imprime o perfil
#      perfil-maquina -d       ignora 1 e 2: so a deteccao do hardware

ARQ=/etc/openbsd-cwm/perfil

detectar() {
	# 1. sensor ACPI de bateria (acpibat0, acpibat1...): o sinal mais confiavel
	if sysctl hw.sensors 2>/dev/null | grep -q '^hw\.sensors\.acpibat[0-9]'; then
		echo notebook
		return
	fi
	# 2. apm: no desktop ele pode responder estado "alta" ou "critica" com 0%,
	#    entao so conta como bateria se o estado (-b) for 0 a 3 E a carga (-l)
	#    for de 1 a 100
	b=$(apm -b 2>/dev/null)
	l=$(apm -l 2>/dev/null)
	case "$b" in
	0|1|2|3)
		case "$l" in
		''|*[!0-9]*) ;;
		*) if [ "$l" -ge 1 ] && [ "$l" -le 100 ]; then echo notebook; return; fi ;;
		esac
		;;
	esac
	echo desktop
}

valido() { [ "$1" = desktop ] || [ "$1" = notebook ]; }

if [ "${1:-}" = -d ]; then
	detectar
	exit 0
fi

if valido "${PERFIL:-}"; then
	echo "$PERFIL"
elif [ -r "$ARQ" ] && valido "$(head -n1 "$ARQ")"; then
	head -n1 "$ARQ"
else
	detectar
fi
