#!/bin/sh
# infos - hora, grupo do cwm, bateria e volume numa notificação (Super+i: não há barra)
# Uso: infos       mostra no dunst por 5 s
#      infos -1    imprime no terminal
# No perfil desktop (perfil-maquina), a bateria nao aparece.

ROMANOS="I II III IV V VI VII VIII IX"

grupo() {
	n=$(xprop -root _NET_CURRENT_DESKTOP 2>/dev/null | awk '{print $3}')
	[ -n "$n" ] || return
	r=$(echo "$ROMANOS" | awk -v i="$n" '{print $i}')
	[ -n "$r" ] && printf 'GRUPO %s   ' "$r"
}

bateria() {
	# no desktop o apm pode responder "0%" sem haver bateria: decide pelo perfil
	[ "$(/usr/local/libexec/openbsd-cwm/perfil-maquina)" = notebook ] || return
	case "$(apm -b 2>/dev/null)" in 4|255|"") return ;; esac
	carga=$(apm -l 2>/dev/null)
	[ "$carga" -ge 0 ] 2>/dev/null || { printf 'BAT ?   '; return; }
	if [ "$(apm -a 2>/dev/null)" = 1 ]; then printf 'BAT %s%% (tomada)   ' "$carga"
	else printf 'BAT %s%%   ' "$carga"; fi
}

volume() {
	nivel=$(sndioctl -n output.level 2>/dev/null) || { printf 'VOL ?'; return; }
	if [ "$(sndioctl -n output.mute 2>/dev/null)" = 1 ]; then printf 'VOL mudo'
	else printf 'VOL %s%%' "$(echo "$nivel" | awk '{printf "%d", $1 * 100 + 0.5}')"; fi
}

TITULO=$(date '+%H:%M  %d/%m/%Y')
CORPO="$(grupo)$(bateria)$(volume)"

if [ "${1:-}" = "-1" ]; then
	printf '%s\n%s\n' "$TITULO" "$CORPO"
else
	dunstify -r 4242 -t 5000 "$TITULO" "$CORPO"
fi
