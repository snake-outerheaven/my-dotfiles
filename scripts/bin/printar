#!/bin/sh
# printar - print da tela direto em Downloads (Print = tela toda, Super+Print = area)
# A pasta Downloads vem do xdg-user-dirs (~/.config/user-dirs.dirs).
DESTINO=$(xdg-user-dir DOWNLOAD 2>/dev/null) || DESTINO="$HOME/Downloads"
[ "$DESTINO" = "$HOME" ] && DESTINO="$HOME/Downloads"
mkdir -p "$DESTINO"
if [ "${1:-}" = "-s" ]; then
	scrot -s "$DESTINO/print-%Y%m%d-%H%M%S.png"
else
	scrot "$DESTINO/print-%Y%m%d-%H%M%S.png"
fi
