#!/bin/sh
# cwm-session - sessao do cwm (o cwm nao tem autostart proprio)
# Chamado pelo ~/.xinitrc (startx) e pelo ~/.xsession (xenodm).

# ~/bin: lugar padrao do OpenBSD para scripts do usuario (o ~/.profile do
# sistema ja o coloca no PATH); exportado aqui porque o xenodm nao le o .profile
export PATH="$HOME/bin:$PATH"

xrdb -merge ~/.Xresources 2>/dev/null

# fundo: ~/.fehbg, ou as flores amarelas (pega-wallpaper), ou cor lisa Tango
fundo

command -v dunst >/dev/null && dunst &
command -v copyq >/dev/null && copyq &
# bloqueio após 5 min parado: i3lock na cor de fundo Tango
command -v i3lock >/dev/null && xidle -timeout 300 -program "/usr/local/bin/i3lock -c 2e3436" &

exec cwm
