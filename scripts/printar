#!/bin/sh
# printar - print da tela na sua pasta de Downloads
#   printar      tela toda   (tecla Print)
#   printar -s   uma area    (Super+Print)
DIR=$(xdg-user-dir DOWNLOAD 2>/dev/null)
[ -n "$DIR" ] && [ "$DIR" != "$HOME" ] || DIR="$HOME/Downloads"
mkdir -p "$DIR"
if [ "${1:-}" = "-s" ]; then
	scrot -s "$DIR/%Y%m%d-%H%M%S.png"
else
	scrot "$DIR/%Y%m%d-%H%M%S.png"
fi
