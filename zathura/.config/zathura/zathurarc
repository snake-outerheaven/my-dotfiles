# zathurarc - leitor de PDF em Tango, destaque amarelo
set font                   "Cascadia Code 10"
set selection-clipboard    clipboard
set recolor                true
set recolor-keephue        true
set default-bg             "#2e3436"
set default-fg             "#eeeeec"
set statusbar-bg           "#555753"
set statusbar-fg           "#eeeeec"
set inputbar-bg            "#2e3436"
set inputbar-fg            "#edd400"
set notification-bg        "#2e3436"
set notification-fg        "#edd400"
set notification-error-bg  "#2e3436"
set notification-error-fg  "#ef2929"
set highlight-color        "#edd400"
set highlight-active-color "#f57900"
set completion-bg          "#555753"
set completion-fg          "#eeeeec"
set completion-highlight-bg "#edd400"
set completion-highlight-fg "#2e3436"
set recolor-lightcolor     "#2e3436"
set recolor-darkcolor      "#eeeeec"
# Ctrl+r liga e desliga o modo escuro do PDF
