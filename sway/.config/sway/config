# Sway config: port do i3 (my-dotfiles) para Wayland, paleta Gruvbox
# Referencia: man 5 sway | man 5 sway-input | man 5 sway-bar

set $mod Mod4
set $term alacritty
set $menu fuzzel
set $scripts ~/.config/sway/scripts

# Fonte dos titulos das janelas
font pango:Noto Sans, Noto Sans Color Emoji 12

# Integracao com systemd/dbus e portais (arquivos do pacote sway do Debian)
include /etc/sway/config.d/*
# Portais (screenshare, seletor de arquivos) precisam disso quando o Sway e aberto pelo TTY
exec dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP=sway

### Teclado (no Wayland o layout fica aqui, nao no X)
input type:keyboard {
    xkb_layout br
    xkb_model abnt2
}

### Paleta Gruvbox (escuro)
set $bg      #282828
set $bg_hard #1d2021
set $fg      #ebdbb2
set $red     #fb4934
set $orange  #fe8019
set $yellow  #fabd2f
set $green   #b8bb26
set $blue    #83a598
set $grey    #928374

#                       borda     fundo     texto     indicador child_border
client.focused          $green    $bg       $fg       $yellow   $green
client.focused_inactive $bg_hard  $bg_hard  $grey     $bg_hard  $bg_hard
client.unfocused        $bg_hard  $bg_hard  $grey     $bg_hard  $bg_hard
client.urgent           $red      $red      $bg       $red      $red

### Wallpaper
# Cor solida como base; se existir ~/Imagens/wallpapers/wall.png (ou wall.jpg), ele vira o fundo
output * bg $bg solid_color
exec_always $scripts/wallpaper.sh

### Aparencia
# Sem barra de titulo: so uma borda de 2 px (a cor mostra a janela em foco)
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 10
gaps outer 5

### Autostart
exec dex --autostart --environment sway
# nm-applet: o dex abre o do /etc/xdg/autostart; o override em ~/.config/autostart (pacote autostart) poe --indicator para a bandeja do swaybar
exec '/usr/bin/gnome-keyring-daemon --start --components=secrets,pkcs11'
exec dunst
# Historico do clipboard (texto e imagens) para o Super+V
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
# Tema escuro para apps GTK (substitui o xsettingsd do X)
exec gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
exec gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark'

# Bloqueio apos 5 min e antes de suspender (substitui xautolock + i3lock-fancy)
exec swayidle -w \
    timeout 300 'swaylock -f' \
    before-sleep 'swaylock -f' \
    lock 'swaylock -f'

### Atalhos
# Bloquear a tela manualmente
bindsym $mod+Shift+x exec swaylock -f

# Print da tela inteira / de uma area (substitui o scrot)
bindsym Print exec $scripts/print.sh
bindsym $mod+Print exec $scripts/print.sh area

# Volume (pactl funciona com PipeWire e PulseAudio)
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brilho
bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# Mouse + $mod arrasta janelas (arrastar pela barra de titulo ja vem ligado no Sway)
floating_modifier $mod normal

# Terminal
bindsym $mod+Return exec $term

# Arquivos (ranger) e monitor do sistema (btop)
bindsym $mod+n exec $term -e ranger
bindsym $mod+Shift+b exec $term -e btop

# Clipboard: historico / apagar historico
bindsym $mod+v exec $scripts/clipboard.sh
bindsym $mod+Shift+v exec $scripts/clipboard.sh limpar

# Fechar janela
bindsym $mod+Shift+q kill

# Lancador (tecla D pelo codigo fisico, como no i3)
bindcode $mod+40 exec $menu

# Foco
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Mover janela
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Tela cheia
bindsym $mod+f fullscreen toggle

# Layouts
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Flutuante / tiling
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Container pai
bindsym $mod+a focus parent

# Workspaces com numeros romanos (a barra esconde o numero e mostra so o romano)
# bindcode = posicao fisica da tecla: evita o problema do Shift+numero no ABNT2
set $ws1 "1:I"
set $ws2 "2:II"
set $ws3 "3:III"
set $ws4 "4:IV"
set $ws5 "5:V"
set $ws6 "6:VI"
set $ws7 "7:VII"
set $ws8 "8:VIII"
set $ws9 "9:IX"
set $ws10 "10:X"

bindcode $mod+10 workspace number $ws1
bindcode $mod+11 workspace number $ws2
bindcode $mod+12 workspace number $ws3
bindcode $mod+13 workspace number $ws4
bindcode $mod+14 workspace number $ws5
bindcode $mod+15 workspace number $ws6
bindcode $mod+16 workspace number $ws7
bindcode $mod+17 workspace number $ws8
bindcode $mod+18 workspace number $ws9
bindcode $mod+19 workspace number $ws10

bindcode $mod+Shift+10 move container to workspace number $ws1
bindcode $mod+Shift+11 move container to workspace number $ws2
bindcode $mod+Shift+12 move container to workspace number $ws3
bindcode $mod+Shift+13 move container to workspace number $ws4
bindcode $mod+Shift+14 move container to workspace number $ws5
bindcode $mod+Shift+15 move container to workspace number $ws6
bindcode $mod+Shift+16 move container to workspace number $ws7
bindcode $mod+Shift+17 move container to workspace number $ws8
bindcode $mod+Shift+18 move container to workspace number $ws9
bindcode $mod+Shift+19 move container to workspace number $ws10

# Recarregar a config (o Sway nao tem 'restart' como o i3)
bindsym $mod+Shift+c reload

# Sair do Sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'Sair do Sway? Isso encerra a sessao Wayland.' -B 'Sim, sair' 'swaymsg exit'

# Modo de redimensionar
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 10
    bindsym j resize grow height 10
    bindsym k resize shrink height 10
    bindsym l resize grow width 10

    bindsym Left resize shrink width 10
    bindsym Down resize grow height 10
    bindsym Up resize shrink height 10
    bindsym Right resize grow width 10

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

### Barra (status simples com a data)
bar {
    font Cascadia Mono 10
    position top
    strip_workspace_numbers yes
    height 25
    # status simples (o bumblebee-status foi removido)
    status_command while date +'%a %d/%m %H:%M'; do sleep 30; done

    colors {
        background $bg
        statusline $fg
        separator  $grey
        #                  borda    fundo    texto
        focused_workspace  $green   $green   $bg
        active_workspace   $bg_hard $bg_hard $fg
        inactive_workspace $bg      $bg      $grey
        urgent_workspace   $red     $red     $bg
    }
}
