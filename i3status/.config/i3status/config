# ~/.config/i3status/config - i3status no OpenBSD (Gruvbox, destaque amarelo)
# Testar:   i3status -c ~/.config/i3status/config
# Aplicar:  i3-msg reload

general {
        colors = true
        color_good = "#b8bb26"
        color_degraded = "#fabd2f"
        color_bad = "#fb4934"
        interval = 5
}

order += "volume master"
order += "battery 0"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "load"
order += "tztime local"

volume master {
        format = "vol %volume"
        format_muted = "vol muted"
}

battery 0 {
        format = "%status %percentage %remaining"
        format_down = "no bat"
        status_chr = "charging"
        status_bat = "bat"
        status_full = "full"
        integer_battery_capacity = true
        low_threshold = 15
        threshold_type = "percentage"
}

cpu_usage {
        format = "cpu %usage"
        degraded_threshold = 75
        max_threshold = 90
}

# memory le /proc/meminfo; se no OpenBSD aparecer erro, apague este bloco
# e a linha order += "memory"
memory {
        format = "ram %used/%total"
        threshold_degraded = "1G"
        threshold_critical = "500M"
        format_degraded = "ram %available left"
}

disk "/" {
        format = "hd %avail"
        low_threshold = 10
        threshold_type = "percentage_free"
}

load {
        format = "load %1min"
        max_threshold = 4
}

tztime local {
        format = "%d/%m %H:%M"
}
