# ~/.config/i3status/config - i3status no OpenBSD (preto com amarelo vivo)

general {
        colors = true
        color_good = "#ffcc00"
        color_degraded = "#ff9f1c"
        color_bad = "#ff5555"
        interval = 5
}

order += "volume master"
order += "battery 0"
order += "cpu_usage"
order += "tztime local"

volume master {
        format = "vol %volume"
        format_muted = "vol %volume"
}

battery 0 {
        format = "%status %percentage %remaining"
        format_down = "no bat"
        status_chr = "charging"
        status_bat = "bat"
        status_full = "full"
        integer_battery_capacity = true
        low_threshold = 15
}

cpu_usage {
        format = "cpu %usage"
}

tztime local {
        format = "%d/%m %H:%M"
}
