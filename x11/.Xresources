! ~/.Xresources - Tango, destaque amarelo (#edd400), para o xterm e programas X da base
! Carregado pelo cwm-session (xrdb -merge). Testar mudanças: xrdb -merge ~/.Xresources

! --- xterm ---
XTerm*termName:        xterm-256color
XTerm*renderFont:      true
XTerm*faceName:        NotoSansM Nerd Font Mono
XTerm*faceSize:        10
XTerm*internalBorder:  8
XTerm*scrollBar:       false
XTerm*saveLines:       5000
XTerm*bellIsUrgent:    true
XTerm*selectToClipboard: true
XTerm*metaSendsEscape: true
XTerm*cursorBlink:     false

! --- cores (Tango) ---
*.background:  #2e3436
*.foreground:  #eeeeec
*.cursorColor: #edd400
XTerm*background:  #2e3436
XTerm*foreground:  #eeeeec
XTerm*cursorColor: #edd400
*.color0:   #2e3436
*.color1:   #cc0000
*.color2:   #4e9a06
*.color3:   #c4a000
*.color4:   #3465a4
*.color5:   #75507b
*.color6:   #06989a
*.color7:   #d3d7cf
*.color8:   #555753
*.color9:   #ef2929
*.color10:  #8ae234
*.color11:  #fce94f
*.color12:  #729fcf
*.color13:  #ad7fa8
*.color14:  #34e2e2
*.color15:  #eeeeec

! --- xclock (relógio da base) ---
XClock*background: #2e3436
XClock*foreground: #edd400
XClock*hands:      #edd400
XClock*highlight:  #eeeeec
